<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Type scale. Sizes are sp so system font scaling applies; no view declares a fixed height. -->
    <style name="TextAppearance.VoiceTyping.Wordmark" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/vtInk</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.VoiceTyping.Trustline" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">?attr/vtInkMuted</item>
    </style>

    <style name="TextAppearance.VoiceTyping.SectionLabel" parent="TextAppearance.MaterialComponents.Overline">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.10</item>
        <item name="android:textColor">?attr/vtInkMuted</item>
    </style>

    <!-- The one piece of large type on the screen: whatever state the app is actually in. -->
    <style name="TextAppearance.VoiceTyping.Headline" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/vtInk</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.VoiceTyping.RowTitle" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">?attr/vtInk</item>
    </style>

    <style name="TextAppearance.VoiceTyping.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">?attr/vtInk</item>
        <item name="android:lineSpacingExtra">3sp</item>
    </style>

    <style name="TextAppearance.VoiceTyping.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?attr/vtInkMuted</item>
        <item name="android:lineSpacingExtra">2sp</item>
    </style>

    <style name="TextAppearance.VoiceTyping.StatusValue" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/vtInk</item>
    </style>

    <!-- Numeric treatment: tabular figures keep the elapsed timer from shifting on every tick. -->
    <style name="TextAppearance.VoiceTyping.Timer" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <!-- Reusable blocks -->
    <style name="Widget.VoiceTyping.SectionLabel" parent="">
        <item name="android:textAppearance">@style/TextAppearance.VoiceTyping.SectionLabel</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="Widget.VoiceTyping.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:textColor">?attr/vtOnAccent</item>
        <item name="backgroundTint">?attr/vtAccent</item>
        <item name="cornerRadius">@dimen/radius_field</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.VoiceTyping.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:textColor">@color/recording_coral</item>
        <item name="strokeColor">@color/recording_coral</item>
        <item name="rippleColor">@color/recording_coral</item>
        <item name="cornerRadius">@dimen/radius_field</item>
    </style>

    <!-- Row-level action: reads as a button without four filled accent blocks down the screen. -->
    <style name="Widget.VoiceTyping.Button.Tonal" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minWidth">88dp</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:textColor">?attr/vtAccent</item>
        <item name="backgroundTint">?attr/vtAccentWash</item>
        <item name="cornerRadius">@dimen/radius_field</item>
    </style>

    <style name="Widget.VoiceTyping.Button.Inline" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minWidth">@dimen/touch_min</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:textColor">?attr/vtAccent</item>
    </style>

    <style name="Widget.VoiceTyping.Field" parent="">
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:textAppearance">@style/TextAppearance.VoiceTyping.Body</item>
        <item name="android:textColor">?attr/vtInk</item>
        <item name="android:textColorHint">?attr/vtInkMuted</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:paddingStart">@dimen/space_3</item>
        <item name="android:paddingEnd">@dimen/space_3</item>
        <item name="android:paddingTop">@dimen/space_2</item>
        <item name="android:paddingBottom">@dimen/space_2</item>
        <item name="android:textCursorDrawable">@null</item>
    </style>

    <!-- A card that is also a tap target: the attention cards and nothing else. -->
    <style name="Widget.VoiceTyping.Card.Clickable" parent="">
        <item name="android:background">@drawable/bg_card_selectable</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">@dimen/space_4</item>
        <item name="android:paddingEnd">@dimen/space_4</item>
        <item name="android:paddingTop">@dimen/space_3</item>
        <item name="android:paddingBottom">@dimen/space_3</item>
    </style>

    <!-- One row of the grouped list under the hero. Dividers are drawn between them. -->
    <style name="Widget.VoiceTyping.ListRow" parent="">
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">@dimen/space_4</item>
        <item name="android:paddingEnd">@dimen/space_4</item>
    </style>

    <!-- Expandable disclosure rows and the mode selector both need a focus-visible tap target. -->
    <style name="Widget.VoiceTyping.Row" parent="">
        <item name="android:background">@drawable/bg_row_selectable</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>

</resources>

    <string name="privacy_row_title">What VoiceTyping can see</string>
    <string name="privacy_body">Microphone and display over other apps. Nothing else: no keyboard service, no accessibility service, no analytics. Speech is transcribed by the Android speech service on this device. Text leaves the device only if you add your own refinement key in Settings.</string>


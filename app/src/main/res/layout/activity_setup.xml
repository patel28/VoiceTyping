<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/setup_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/setup_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/vtCanvas"
        android:minHeight="?attr/actionBarSize"
        app:navigationContentDescription="@string/action_back"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/setup_title"
        app:titleCentered="false"
        app:titleTextColor="?attr/vtInk" />

    <ScrollView
        android:id="@+id/setup_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/gutter"
        android:paddingEnd="@dimen/gutter"
        android:paddingBottom="@dimen/space_6">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text="@string/setup_subtitle"
                android:textAppearance="@style/TextAppearance.VoiceTyping.Body" />

            <TextView
                android:id="@+id/setup_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:textAppearance="@style/TextAppearance.VoiceTyping.SectionLabel" />

            <!-- Rows are inflated here, one per requirement that applies to this phone. -->
            <LinearLayout
                android:id="@+id/setup_steps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/setup_complete_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="@string/setup_complete_note"
                android:textAppearance="@style/TextAppearance.VoiceTyping.Caption"
                android:textColor="@color/success_mint"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/setup_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/vtCanvas"
        android:orientation="vertical"
        android:paddingStart="@dimen/gutter"
        android:paddingTop="@dimen/space_2"
        android:paddingEnd="@dimen/gutter"
        android:paddingBottom="@dimen/space_4">

        <Button
            android:id="@+id/setup_done"
            style="@style/Widget.VoiceTyping.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_done" />
    </LinearLayout>
</LinearLayout>

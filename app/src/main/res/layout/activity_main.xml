<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- App bar: wordmark, trust line, settings. Insets are applied as padding in MainActivity. -->
    <LinearLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="@dimen/gutter"
        android:paddingTop="@dimen/space_4"
        android:paddingEnd="@dimen/space_2"
        android:paddingBottom="@dimen/space_3">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textAppearance="@style/TextAppearance.VoiceTyping.Wordmark" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="2dp"
                android:text="@string/main_trust_line"
                android:textAppearance="@style/TextAppearance.VoiceTyping.Trustline" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/open_settings"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:layout_gravity="center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_settings"
            android:src="@drawable/ic_settings"
            app:tint="@color/ink_muted" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/main_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/gutter"
        android:paddingEnd="@dimen/gutter"
        android:paddingBottom="@dimen/space_6">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Readiness instrument -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_surface_raised"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_4"
                android:paddingTop="@dimen/space_4"
                android:paddingEnd="@dimen/space_4"
                android:paddingBottom="@dimen/space_4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/readiness_icon"
                        android:layout_width="@dimen/icon_row"
                        android:layout_height="@dimen/icon_row"
                        android:layout_gravity="center_vertical"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_warning"
                        app:tint="@color/warning_amber" />

                    <TextView
                        android:id="@+id/readiness_headline"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="@dimen/space_2"
                        android:layout_weight="1"
                        android:text="@string/state_setup_required"
                        android:textAppearance="@style/TextAppearance.VoiceTyping.SectionLabel"
                        android:textColor="@color/ink" />
                </LinearLayout>

                <com.voicetyping.directtest.SignalRailView
                    android:id="@+id/signal_rail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:layout_marginBottom="@dimen/space_2" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/hairline"
                    android:layout_marginBottom="@dimen/space_1"
                    android:background="@color/hairline" />

                <!-- Microphone permission -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:minHeight="@dimen/touch_min"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/mic_icon"
                        android:layout_width="@dimen/icon_row"
                        android:layout_height="@dimen/icon_row"
                        android:layout_gravity="center_vertical"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_mic"
                        app:tint="@color/ink_muted" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="@dimen/space_3"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/perm_mic_title"
                            android:textAppearance="@style/TextAppearance.VoiceTyping.StatusValue" />

                        <TextView
                            android:id="@+id/mic_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/perm_missing"
                            android:textAppearance="@style/TextAppearance.VoiceTyping.Caption" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/mic_action"
                        style="@style/Widget.VoiceTyping.Button.Inline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:text="@string/action_allow" />
                </LinearLayout>

                <!-- Overlay permission -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:minHeight="@dimen/touch_min"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/overlay_icon"
                        android:layout_width="@dimen/icon_row"
                        android:layout_height="@dimen/icon_row"
                        android:layout_gravity="center_vertical"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_overlay"
                        app:tint="@color/ink_muted" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="@dimen/space_3"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/perm_overlay_title"
                            android:textAppearance="@style/TextAppearance.VoiceTyping.StatusValue" />

                        <TextView
                            android:id="@+id/overlay_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/perm_missing"
                            android:textAppearance="@style/TextAppearance.VoiceTyping.Caption" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/overlay_action"
                        style="@style/Widget.VoiceTyping.Button.Inline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:text="@string/action_allow" />
                </LinearLayout>

                <Button
                    android:id="@+id/primary_action"
                    style="@style/Widget.VoiceTyping.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:text="@string/action_allow_mic" />

                <Button
                    android:id="@+id/stop_action"
                    style="@style/Widget.VoiceTyping.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:text="@string/action_stop_bubble"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/api_key_missing_warning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:background="@drawable/bg_wash_pill"
                    android:clickable="true"
                    android:contentDescription="@string/api_key_missing_warning_a11y"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/touch_min"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_3"
                    android:paddingTop="@dimen/space_2"
                    android:paddingEnd="@dimen/space_2"
                    android:paddingBottom="@dimen/space_2">

                    <ImageView
                        android:layout_width="@dimen/icon_row"
                        android:layout_height="@dimen/icon_row"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_warning"
                        app:tint="@color/warning_amber" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_2"
                        android:layout_weight="1"
                        android:importantForAccessibility="no"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/api_key_missing_warning_title"
                            android:textAppearance="@style/TextAppearance.VoiceTyping.StatusValue"
                            android:textColor="@color/warning_amber_text" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/api_key_missing_warning_body"
                            android:textAppearance="@style/TextAppearance.VoiceTyping.Caption"
                            android:textColor="@color/ink" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/touch_min"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:paddingStart="@dimen/space_2"
                        android:paddingEnd="@dimen/space_1"
                        android:text="@string/action_open_settings"
                        android:textAppearance="@style/TextAppearance.VoiceTyping.StatusValue"
                        android:textColor="@color/signal_blue" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/mode_summary_row"
                    style="@style/Widget.VoiceTyping.Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/mode_summary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.VoiceTyping.Caption" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center_vertical"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/ink_muted" />
                </LinearLayout>
            </LinearLayout>

            <!-- First-use instruction -->
            <TextView
                style="@style/Widget.VoiceTyping.SectionLabel"
                android:layout_marginTop="@dimen/space_6"
                android:layout_marginBottom="@dimen/space_3"
                android:text="@string/steps_label" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="@dimen/icon_step"
                        android:layout_height="@dimen/icon_step"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_field"
                        app:tint="@color/ink" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="@dimen/space_2"
                        android:text="@string/step_focus"
                        android:textAppearance="@style/TextAppearance.VoiceTyping.Caption"
                        android:textColor="@color/ink" />
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="top"
                    android:layout_marginTop="4dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/ink_muted" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/space_2"
                    android:paddingEnd="0dp">

                    <ImageView
                        android:layout_width="@dimen/icon_step"
                        android:layout_height="@dimen/icon_step"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_mic"
                        app:tint="@color/signal_blue" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="@dimen/space_2"
                        android:text="@string/step_speak"
                        android:textAppearance="@style/TextAppearance.VoiceTyping.Caption"
                        android:textColor="@color/ink" />
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="top"
                    android:layout_marginTop="4dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/ink_muted" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="0dp"
                    android:paddingStart="@dimen/space_2">

                    <ImageView
                        android:layout_width="@dimen/icon_step"
                        android:layout_height="@dimen/icon_step"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_paste"
                        app:tint="@color/ink" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="@dimen/space_2"
                        android:text="@string/step_paste"
                        android:textAppearance="@style/TextAppearance.VoiceTyping.Caption"
                        android:textColor="@color/ink" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/step_gesture"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:background="@drawable/bg_wash_pill"
                android:paddingStart="@dimen/space_3"
                android:paddingTop="@dimen/space_2"
                android:paddingEnd="@dimen/space_3"
                android:paddingBottom="@dimen/space_2"
                android:textAppearance="@style/TextAppearance.VoiceTyping.Caption"
                android:textColor="@color/ink" />

            <!-- Privacy disclosure -->
            <LinearLayout
                android:id="@+id/privacy_row"
                style="@style/Widget.VoiceTyping.Row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_5"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:text="@string/privacy_row_title"
                    android:textAppearance="@style/TextAppearance.VoiceTyping.StatusValue" />

                <ImageView
                    android:id="@+id/privacy_chevron"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center_vertical"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_down"
                    app:tint="@color/ink_muted" />
            </LinearLayout>

            <TextView
                android:id="@+id/privacy_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="@dimen/space_2"
                android:text="@string/privacy_body"
                android:textAppearance="@style/TextAppearance.VoiceTyping.Caption"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/hairline"
                android:layout_marginTop="@dimen/space_2"
                android:background="@color/hairline" />

            <!-- Paste sandbox -->
            <TextView
                style="@style/Widget.VoiceTyping.SectionLabel"
                android:layout_marginTop="@dimen/space_5"
                android:layout_marginBottom="@dimen/space_2"
                android:text="@string/sandbox_label" />

            <EditText
                android:id="@+id/sandbox_field"
                style="@style/Widget.VoiceTyping.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:hint="@string/sandbox_hint"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="3"
                android:paddingTop="@dimen/space_3"
                android:paddingBottom="@dimen/space_3" />

            <TextView
                android:id="@+id/sandbox_helper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingEnd="@dimen/space_1"
                android:paddingStart="@dimen/space_1"
                android:paddingTop="@dimen/space_2"
                android:text="@string/sandbox_helper_idle"
                android:textAppearance="@style/TextAppearance.VoiceTyping.Caption" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>

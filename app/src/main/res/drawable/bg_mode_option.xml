<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/vtAccentWash" />
            <corners android:radius="@dimen/radius_field" />
            <stroke android:width="2dp" android:color="?attr/vtAccent" />
        </shape>
    </item>
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/vtAccentWash" />
            <corners android:radius="@dimen/radius_field" />
            <stroke android:width="2dp" android:color="?attr/vtAccent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/radius_field" />
            <stroke android:width="@dimen/hairline" android:color="?attr/vtHairline" />
        </shape>
    </item>
</selector>

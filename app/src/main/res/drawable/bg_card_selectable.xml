<?xml version="1.0" encoding="utf-8"?>
<!-- A raised surface that is also a tap target: same shape as bg_surface_raised, with a ripple. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/vtAccentWash">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/vtSurface" />
            <corners android:radius="@dimen/radius_surface" />
            <stroke android:width="@dimen/hairline" android:color="?attr/vtHairline" />
        </shape>
    </item>
</ripple>

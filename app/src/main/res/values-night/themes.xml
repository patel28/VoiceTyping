<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Only the bar-icon polarity differs at night; the colours come from values-night/colors.xml. -->
    <style name="Theme.VoiceTyping" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">?attr/vtAccent</item>
        <item name="colorOnPrimary">?attr/vtOnAccent</item>
        <item name="colorSecondary">@color/success_mint</item>
        <item name="colorOnSecondary">?attr/vtOnAccent</item>
        <item name="colorError">@color/recording_coral</item>
        <item name="android:colorAccent">?attr/vtAccent</item>
        <item name="android:textColorPrimary">?attr/vtInk</item>
        <item name="android:textColorSecondary">?attr/vtInkMuted</item>
        <item name="android:textColorHint">?attr/vtInkMuted</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
